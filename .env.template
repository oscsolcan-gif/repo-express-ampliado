# Plantilla del .env: copia este fichero como .env y pon tus valores.
# Este fichero SÍ se sube a GitHub (no lleva datos reales); el .env NO.

# Puerto en el que escucha el servidor
PORT=

# Cadena de conexión a MongoDB (la variable se llama URI, como en la clase).
# DESARROLLO (tu portátil, Mongo en Docker):
URI=
# PRODUCCIÓN (Atlas): NO se escribe aquí. Se pone en el panel de Render como variable de entorno.
# Tiene esta forma: mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/NOMBRE_BD
